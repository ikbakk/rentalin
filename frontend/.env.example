# Copy to frontend/.env.local for local builds. Set the same values on the host
# before building; NEXT_PUBLIC_* values are compiled into browser JavaScript.
NEXT_PUBLIC_CONVEX_URL=https://your-development-deployment.convex.cloud
# Public URL used by the release preflight; Convex provides it automatically
# inside backend functions (do not set that reserved variable on Convex).
CONVEX_SITE_URL=https://your-development-deployment.convex.site
NEXT_PUBLIC_FRONTEND_URL=https://app.example.com
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Optional Sentry DSNs. Never put R2 keys, email keys or signing keys here.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

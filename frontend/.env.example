# Public Convex deployment URL printed by `npx convex dev` or `npx convex deploy`.
# This is a URL, not a secret.
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# Matching Convex Auth site URL for the same deployment. Also configure this
# variable in the Convex deployment environment; see frontend/README.md.
CONVEX_SITE_URL=https://your-deployment.convex.site

# Public canonical app origin used for generated booking links.
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000

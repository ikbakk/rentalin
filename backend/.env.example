# Rentalin Environment Configuration
# Copy this file to .env and fill in production values
# Do NOT commit .env to version control

# ── Database ─────────────────────────────────────────────────
# SQLite (single-VPS): Data Source=/data/rentalin.db
# PostgreSQL: Host=localhost;Database=rentalin;Username=rentalin;Password=changeme
CONNECTIONSTRINGS__DEFAULT=Data Source=/data/rentalin.db

# ── JWT Authentication ───────────────────────────────────────
# Generate a strong secret: openssl rand -base64 32
JWT__SECRET=change-this-to-a-random-32-character-string

# ── CORS ─────────────────────────────────────────────────────
# Frontend origin URL for CORS
CORS__FRONTENDORIGIN=https://rentalin.example.com

# ── ASP.NET ──────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:5000

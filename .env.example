# Local Convex CLI selector. `npx convex dev` writes the actual selected deployment.
CONVEX_DEPLOYMENT=dev:your-development-deployment

# BACKEND configuration: copy these values into the selected Convex deployment's
# Settings > Environment Variables. A local .env file alone does not configure
# hosted Convex actions. Use different buckets/keys for staging and production.
SITE_URL=https://app.example.com
# Generate the matching JWT_PRIVATE_KEY + JWKS with Convex Auth setup;
# never commit real keys or overwrite an existing deployment's signing keys.
JWT_PRIVATE_KEY=
JWKS=

# Private Cloudflare R2 bucket (Object Read & Write token scoped to this bucket).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=rentalin-staging-private

# Password reset email: Resend API key and verified sender address.
AUTH_RESEND_KEY=
AUTH_EMAIL_FROM=Rentalin <accounts@example.com>

# Turnstile: exact frontend hostname, with no scheme, path, or port.
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=app.example.com

# Local deployment/Compose PUBLIC build settings. Also copy the relevant ones
# into frontend/.env.local and landing/.env (see those examples).
NEXT_PUBLIC_CONVEX_URL=https://your-development-deployment.convex.cloud
CONVEX_SITE_URL=https://your-development-deployment.convex.site
NEXT_PUBLIC_FRONTEND_URL=https://app.example.com
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
PUBLIC_APP_URL=https://app.example.com
PUBLIC_WHATSAPP_NUMBER=

# Optional frontend error reporting; SENTRY_DSN is server runtime only.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

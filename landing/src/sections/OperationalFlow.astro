---
import { MessageCircle, CalendarCheck, KeyRound, ClipboardCheck } from 'lucide-react';
const stages = [
  { title: 'Inquiry', detail: 'A customer asks about a vehicle. Staff checks availability and sends a quote.', Icon: MessageCircle },
  { title: 'Reservation', detail: 'Confirm the booking and record the deposit in the same flow.', Icon: CalendarCheck },
  { title: 'Handover', detail: 'Record the ID check, signature, odometer and vehicle condition.', Icon: KeyRound },
  { title: 'Return', detail: 'Capture the final odometer, fuel and inspection before closing the rental.', Icon: ClipboardCheck },
];
---

<section id="workflow" class="border-y border-border bg-card py-20 lg:py-28">
  <div class="mx-auto max-w-7xl px-5 sm:px-8 lg:px-12">
    <div class="flex flex-col justify-between gap-7 md:flex-row md:items-end">
      <h2 class="max-w-2xl text-4xl font-semibold leading-[1.06] tracking-[-.045em] text-balance sm:text-5xl lg:text-6xl">One clear line from request to return.</h2>
      <p class="max-w-sm text-base leading-relaxed text-muted-foreground">Keep the work moving while every handoff leaves a record your team can follow.</p>
    </div>
    <ol class="mt-14 grid border-t-2 border-primary md:grid-cols-4">
      {stages.map((stage) => (
        <li class="border-b border-border py-7 pr-7 md:min-h-64 md:border-b-0 md:border-r md:px-5 md:first:pl-0 md:last:border-r-0">
          <div class="flex items-center justify-end gap-3"><stage.Icon class="size-6 text-primary" strokeWidth={1.6} aria-hidden="true" /></div>
          <h3 class="mt-7 text-2xl font-semibold tracking-tight">{stage.title}</h3>
          <p class="mt-3 max-w-xs text-sm leading-relaxed text-muted-foreground">{stage.detail}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

---
import {
  MessageCircle,
  CalendarCheck,
  PenLine,
  RotateCcw
} from 'lucide-react';
import ClientBlurText from '../components/ClientBlurText.astro';
import ClientSplitText from '../components/ClientSplitText.astro';
import ClientTiltedCard from '../components/ClientTiltedCard.astro';

// ---------------------------------------------------------------
// Neon-Tropical Industrial palette (locked tokens, mirrored as
// SVG literals because data-URI images cannot read CSS variables)
// ---------------------------------------------------------------
const AMBER = 'oklch(0.75 0.18 85)'; // --primary
const GREEN = 'oklch(0.70 0.20 145)'; // --accent
const SVG_BG = 'oklch(0.13 0.008 280)'; // one step below --card for depth
const SVG_BORDER = 'oklch(0.24 0.008 280)'; // --border

// Lucide 24x24 path data, mirrored in each card's SVG glyph so the
// caption icon and the tilt artwork stay visually identical.
const GLYPHS = {
  inquiry:
    '<path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/>',
  reservation:
    '<rect width="18" height="18" x="3" y="4" rx="2"/><path d="M16 2v4"/><path d="M8 2v4"/><path d="M3 10h18"/><path d="m9 16 2 2 4-4"/>',
  handover:
    '<path d="M12 20h9"/><path d="M16.376 3.622a1 1 0 0 1 3.002 3.002L7.368 18.635a2 2 0 0 1-.855.506l-2.872.838a.5.5 0 0 1-.62-.62l.838-2.872a2 2 0 0 1 .506-.855z"/>',
  return:
    '<path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/>'
};

const BRACKETS = {
  TL: '<path d="M26 66V26h40"/>',
  TR: '<path d="M354 26h40v40"/>',
  BR: '<path d="M394 334v40h-40"/>',
  BL: '<path d="M66 374H26v-40"/>'
};

// 4-segment pipeline progress rail at the card's base — the filled
// count carries the step's position in the flow (sequence meaning).
function progressSegments(step: number, accent: string) {
  const positions = [48, 129, 210, 291];
  return positions
    .map((x, i) => {
      const filled = i < step;
      return `<rect x="${x}" y="344" width="72" height="5" rx="2.5" fill="${
        filled ? accent : 'rgba(255,255,255,0.07)'
      }"/>`;
    })
    .join('');
}

// Industrial stage artwork: tinted plate, blueprint corner brackets,
// ring + crosshair ticks, a diagonal energy line, the lucide glyph,
// and the step-progress rail. Composed per stage so no two look alike.
function stageVisual(accent: string, glyph: string, step: number, bracketKeys: string[]) {
  const brackets = bracketKeys.map((k) => BRACKETS[k as keyof typeof BRACKETS]).join('');
  const svg = `
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 420 400" preserveAspectRatio="xMidYMid slice">
  <rect width="420" height="400" rx="18" fill="${SVG_BG}"/>
  <rect width="420" height="400" rx="18" fill="${accent}" fill-opacity="0.07"/>
  <rect x="1" y="1" width="418" height="398" rx="17" fill="none" stroke="${SVG_BORDER}" stroke-width="1.5"/>
  <path d="M-30 380 L460 -60" stroke="${accent}" stroke-opacity="0.10" stroke-width="1.5"/>
  <circle cx="210" cy="168" r="80" fill="none" stroke="${accent}" stroke-opacity="0.20" stroke-width="1.5"/>
  <circle cx="210" cy="168" r="58" fill="none" stroke="${accent}" stroke-opacity="0.10" stroke-width="1"/>
  <path d="M210 80v16M210 240v16M122 168h16M282 168h16" stroke="${accent}" stroke-opacity="0.30" stroke-width="2"/>
  ${brackets}
  <g transform="translate(210 168) scale(5)" fill="none" stroke="${accent}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    ${glyph}
  </g>
  ${progressSegments(step, accent)}
</svg>`;
  return `data:image/svg+xml,${encodeURIComponent(svg)}`;
}

// ---------------------------------------------------------------
// The four condensed stages (README.md operational flows, lines
// 20-37). Stages 1-2 run on the amber/primary channel, 3-4 on the
// green/accent channel — the lifecycle shifts color as the car
// moves from "chat" to "road".
// ---------------------------------------------------------------
const stages = [
  {
    name: 'Inquiry',
    heading: 'It starts with a chat',
    description:
      'Customer WhatsApps about a car. Staff logs it, checks availability, sends a quote.',
    Icon: MessageCircle,
    accent: AMBER,
    glyph: GLYPHS.inquiry,
    step: 1,
    bracketKeys: ['TL', 'BR'],
    iconClass: 'text-primary',
    dotClass: 'border-primary/70',
    rotateAmplitude: 12,
    staggerClass: 'stagger-1'
  },
  {
    name: 'Reservation',
    heading: 'Deposit locks it in',
    description: 'Customer confirms. Staff converts to booking and collects the deposit.',
    Icon: CalendarCheck,
    accent: AMBER,
    glyph: GLYPHS.reservation,
    step: 2,
    bracketKeys: ['TR', 'BL'],
    iconClass: 'text-primary',
    dotClass: 'border-primary/70',
    rotateAmplitude: 15,
    staggerClass: 'stagger-2'
  },
  {
    name: 'Handover',
    heading: 'Documented handover',
    description:
      'ID check, digital signature, odometer photo. Keys change hands, documented.',
    Icon: PenLine,
    accent: GREEN,
    glyph: GLYPHS.handover,
    step: 3,
    bracketKeys: ['TL', 'TR', 'BR', 'BL'],
    iconClass: 'text-accent',
    dotClass: 'border-accent/70',
    rotateAmplitude: 13,
    staggerClass: 'stagger-3'
  },
  {
    name: 'Return',
    heading: 'Checked, keys back',
    description:
      'Record odometer and fuel, quick visual check, keys back. Inspect for damage.',
    Icon: RotateCcw,
    accent: GREEN,
    glyph: GLYPHS.return,
    step: 4,
    bracketKeys: ['TL', 'BL'],
    iconClass: 'text-accent',
    dotClass: 'border-accent/70',
    rotateAmplitude: 17,
    staggerClass: 'stagger-4'
  }
];
---

<section id="operational-flow" class="relative overflow-hidden py-24 lg:py-32">
  <!-- Atmosphere: two faint neon washes, no glass -->
  <div aria-hidden="true" class="pointer-events-none absolute inset-0">
    <div class="absolute -left-40 top-1/3 h-96 w-96 rounded-full bg-accent/5 blur-3xl"></div>
    <div class="absolute -right-40 top-1/2 h-96 w-96 rounded-full bg-primary/5 blur-3xl"></div>
  </div>

  <div class="relative mx-auto max-w-6xl px-4 lg:px-8">
    <!-- Heading -->
    <div class="mx-auto mb-16 max-w-2xl text-center">
      <ClientSplitText
        text="From WhatsApp to the road. In four steps."
        tag="h2"
        className="text-3xl font-bold font-heading tracking-tight lg:text-5xl"
      />
      <ClientBlurText
        text="The complete rental lifecycle, built for how Indonesian rental shops actually work."
        className="mt-4 text-lg text-muted-foreground"
      />
    </div>

    <!-- Pipeline: 4 tilt cards, sequence reveal, mobile connector rail -->
    <div class="relative">
      <!-- Mobile vertical connector line (stack only; hidden on lg grid) -->
      <div
        aria-hidden="true"
        class="absolute bottom-0 left-6 top-0 w-px bg-gradient-to-b from-primary via-accent to-transparent lg:hidden"
      ></div>

      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        {stages.map((stage) => {
          const StageIcon = stage.Icon;
          return (
            <div class={`relative pl-14 md:pl-0 animate-fade-up ${stage.staggerClass}`}>
              <!-- Connector node, aligned to the rail on mobile -->
              <span
                aria-hidden="true"
                class={`absolute left-[18px] top-8 hidden size-3 rounded-full border bg-background md:hidden ${stage.dotClass}`}
              ></span>

              <ClientTiltedCard
                imageSrc={stageVisual(stage.accent, stage.glyph, stage.step, stage.bracketKeys)}
                altText={`${stage.name} stage artwork`}
                containerHeight="280px"
                containerWidth="100%"
                imageHeight="240px"
                imageWidth="100%"
                scaleOnHover={1.05}
                rotateAmplitude={stage.rotateAmplitude}
              />

              <div class="mt-5">
                <div class="flex items-center gap-2">
                  <StageIcon class={`size-4 ${stage.iconClass}`} />
                  <p class="font-mono text-xs uppercase tracking-widest text-muted-foreground">
                    {stage.name}
                  </p>
                </div>
                <h3 class="mt-2 font-heading text-lg font-bold text-foreground">{stage.heading}</h3>
                <p class="mt-1.5 text-sm leading-relaxed text-muted-foreground">
                  {stage.description}
                </p>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </div>
</section>

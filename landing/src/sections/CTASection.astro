---
import { ArrowUpRight } from 'lucide-react';
import { APP_DEMO_URL, APP_LOGIN_URL } from '../lib/contact';
---

<section class="relative overflow-hidden py-20 lg:py-28">
  <img src="/ornaments/rental-lot-route.svg" alt="" aria-hidden="true" class="pointer-events-none absolute right-0 top-6 hidden w-[45%] opacity-25 lg:block" loading="lazy" />
  <div class="relative mx-auto max-w-7xl px-5 sm:px-8 lg:px-12">
    <div class="grid gap-9 border-b-2 border-primary pb-16 lg:grid-cols-[1.2fr_.8fr] lg:items-end">
      <div>
        <h2 class="max-w-3xl text-4xl font-semibold leading-[1.06] tracking-[-.045em] text-balance sm:text-5xl lg:text-6xl">Ready to run a clearer rental day?</h2>
        <p class="mt-6 max-w-xl leading-relaxed text-muted-foreground">See how Rentalin brings your fleet, bookings, inspections and team activity into one flow.</p>
      </div>
      <div class="flex flex-wrap gap-4 lg:justify-end">
        <a href={APP_DEMO_URL} class="inline-flex min-h-12 items-center gap-3 bg-primary px-6 font-semibold text-primary-foreground transition-colors hover:bg-foreground">Try the demo <ArrowUpRight class="size-5" /></a>
        <a href={APP_LOGIN_URL} class="inline-flex min-h-12 items-center border border-primary bg-background px-6 font-semibold text-primary transition-colors hover:bg-muted">Staff login</a>
      </div>
    </div>
    <footer class="flex flex-col justify-between gap-4 pt-7 text-sm text-muted-foreground sm:flex-row">
      <p><span class="font-semibold text-foreground">rentalin<span class="text-accent">.</span></span> © 2026</p>
      <p>From chat to keys back.</p>
    </footer>
  </div>
</section>

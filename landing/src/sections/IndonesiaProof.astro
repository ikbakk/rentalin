---
import { WifiOff, Hand, Sun } from 'lucide-react';
const proofs = [
  { number: '01', title: 'Works offline', detail: 'Critical work remains available when the signal drops.', Icon: WifiOff },
  { number: '02', title: 'One-handed use', detail: 'Designed for staff on their feet, with short paths through common actions.', Icon: Hand },
  { number: '03', title: 'Sunlight-readable', detail: 'High-contrast screens stay legible in bright outdoor light.', Icon: Sun },
];
---

<section id="indonesia" class="bg-primary py-20 text-primary-foreground lg:py-28">
  <div class="mx-auto max-w-7xl px-5 sm:px-8 lg:px-12">
    <div class="flex flex-col justify-between gap-7 md:flex-row md:items-end">
      <h2 class="max-w-2xl text-4xl font-semibold leading-[1.06] tracking-[-.045em] text-balance sm:text-5xl">Made for the rental lot, not just the desk.</h2>
      <p class="max-w-sm leading-relaxed text-primary-foreground/75">Indonesian rental shops move between the counter, the parking area and the road.</p>
    </div>
    <div class="mt-14 grid border-t border-primary-foreground/35 md:grid-cols-3">
      {proofs.map((proof) => (
        <article class="border-b border-primary-foreground/35 py-7 md:border-b-0 md:border-r md:px-7 md:first:pl-0 md:last:border-r-0">
          <div class="flex items-center justify-between gap-3"><span class="sheet-number text-sm text-[#edbd58]">{proof.number} / 03</span><proof.Icon class="size-6 text-[#edbd58]" strokeWidth={1.6} aria-hidden="true" /></div>
          <h3 class="mt-8 text-2xl font-semibold">{proof.title}</h3>
          <p class="mt-3 max-w-xs text-sm leading-relaxed text-primary-foreground/75">{proof.detail}</p>
        </article>
      ))}
    </div>
  </div>
</section>

---
import { ArrowRight, ArrowUpRight, MessageCircle, CalendarCheck, KeyRound, ClipboardCheck } from 'lucide-react';
import { APP_DEMO_URL, APP_LOGIN_URL } from '../lib/contact';

const steps = [
  { number: '01', label: 'Inquiry received', state: 'Check availability', Icon: MessageCircle },
  { number: '02', label: 'Reservation confirmed', state: 'Deposit logged', Icon: CalendarCheck },
  { number: '03', label: 'Vehicle handover', state: 'Inspection saved', Icon: KeyRound },
  { number: '04', label: 'Return recorded', state: 'Close rental', Icon: ClipboardCheck },
];
---

<header class="border-b border-border">
  <nav class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-x-5 gap-y-3 px-5 py-5 md:flex-nowrap sm:px-8 lg:px-12" aria-label="Main navigation">
    <a href="/" class="text-2xl font-semibold tracking-[-0.06em]">rentalin<span class="text-accent">.</span></a>
    <button type="button" class="inline-flex size-11 items-center justify-center rounded-lg border border-border text-primary md:hidden" aria-label="Open navigation menu" aria-expanded="false" aria-controls="mobile-navigation">
      <span class="menu-icon" aria-hidden="true"><span class="menu-line menu-line-top"></span><span class="menu-line menu-line-middle"></span><span class="menu-line menu-line-bottom"></span></span>
    </button>
    <div class="hidden items-center gap-9 md:flex">
      <div class="flex items-center gap-9 text-sm font-medium">
        <a href="#workflow" class="hover:text-accent">The workflow</a>
        <a href="#features" class="hover:text-accent">For your team</a>
      </div>
      <div class="flex w-fit items-center justify-end gap-3">
        <a href={APP_LOGIN_URL} class="inline-flex min-h-11 items-center px-2 text-sm font-semibold text-primary underline decoration-border underline-offset-4">Login</a>
        <a href={APP_DEMO_URL} class="inline-flex min-h-11 shrink-0 items-center gap-2 rounded-lg bg-primary px-4 text-sm font-semibold text-primary-foreground transition-colors hover:bg-foreground">Try the demo <ArrowUpRight class="size-4" /></a>
      </div>
    </div>
    <div id="mobile-navigation" class="mobile-navigation w-full flex-col gap-4 md:hidden" inert>
      <a href="#workflow" class="py-2 text-sm font-medium hover:text-accent">The workflow</a>
      <a href="#features" class="py-2 text-sm font-medium hover:text-accent">For your team</a>
      <a href={APP_LOGIN_URL} class="py-2 text-sm font-semibold text-primary">Login</a>
      <a href={APP_DEMO_URL} class="inline-flex min-h-11 items-center justify-center gap-2 rounded-lg bg-primary px-4 text-sm font-semibold text-primary-foreground transition-colors hover:bg-foreground">Try the demo <ArrowUpRight class="size-4" /></a>
    </div>
  </nav>
</header>

<script>
  const menuButton = document.querySelector<HTMLButtonElement>('[aria-controls="mobile-navigation"]');
  const mobileNavigation = document.getElementById('mobile-navigation');

  if (menuButton && mobileNavigation) {
    const closeMenu = () => {
      menuButton.setAttribute('aria-expanded', 'false');
      menuButton.setAttribute('aria-label', 'Open navigation menu');
      mobileNavigation.classList.remove('is-open');
      mobileNavigation.inert = true;
    };

    menuButton.addEventListener('click', () => {
      const isExpanded = menuButton.getAttribute('aria-expanded') === 'true';
      menuButton.setAttribute('aria-expanded', String(!isExpanded));
      menuButton.setAttribute('aria-label', isExpanded ? 'Open navigation menu' : 'Close navigation menu');
      mobileNavigation.classList.toggle('is-open', !isExpanded);
      mobileNavigation.inert = isExpanded;
    });

    mobileNavigation.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') closeMenu();
    });
  }
</script>

<style>
  .mobile-navigation {
    display: flex;
    max-height: 0;
    overflow: hidden;
    border-top: 0 solid var(--border);
    padding-top: 0;
    opacity: 0;
    pointer-events: none;
    transition: max-height 300ms ease-in-out, opacity 200ms ease-in-out, padding-top 300ms ease-in-out, border-width 300ms ease-in-out;
  }

  .mobile-navigation.is-open {
    max-height: 24rem;
    border-top-width: 1px;
    padding-top: 1rem;
    opacity: 1;
    pointer-events: auto;
  }

  .menu-icon { display: flex; width: 1.25rem; flex-direction: column; gap: .375rem; }
  .menu-line { display: block; width: 100%; height: 2px; background: currentColor; transition: transform 300ms ease-in-out, opacity 200ms ease-in-out; }
  [aria-expanded="true"] .menu-line-top { transform: translateY(8px) rotate(45deg); }
  [aria-expanded="true"] .menu-line-middle { opacity: 0; }
  [aria-expanded="true"] .menu-line-bottom { transform: translateY(-8px) rotate(-45deg); }

  @media (prefers-reduced-motion: reduce) {
    .mobile-navigation, .menu-line { transition-duration: .01ms; }
  }
</style>

<section class="mx-auto grid max-w-7xl gap-14 px-5 pb-20 pt-16 sm:px-8 lg:min-h-[760px] lg:grid-cols-[1.03fr_.97fr] lg:items-center lg:gap-16 lg:px-12 lg:pb-28 lg:pt-20">
  <div>
    <h1 class="max-w-3xl text-[clamp(3.5rem,6.6vw,6.7rem)] font-semibold leading-[.98] tracking-[-.055em] text-balance">From chat<br />to <span class="sheet-highlight">keys back.</span></h1>
    <p class="mt-7 max-w-lg text-lg leading-relaxed text-muted-foreground sm:text-xl">One place for inquiries, reservations, handovers and returns. Built for the pace of Indonesian rental shops.</p>
    <div class="mt-9 flex flex-wrap items-center gap-x-7 gap-y-4">
      <a href={APP_DEMO_URL} class="inline-flex min-h-12 items-center gap-3 rounded-lg bg-primary px-6 font-semibold text-primary-foreground transition-colors hover:bg-foreground">Try the demo <ArrowUpRight class="size-5" /></a>
      <a href="#workflow" class="inline-flex items-center gap-2 font-semibold underline decoration-border underline-offset-8 hover:decoration-accent">See how it works <ArrowRight class="size-4" /></a>
    </div>
    <p class="mt-12 max-w-lg border-t border-border pt-5 text-sm text-muted-foreground">For rental businesses with 1–50 vehicles · Designed for staff on the move</p>
  </div>

  <div class="relative">
    <div class="absolute -bottom-4 -right-4 top-4 w-full rounded-xl bg-muted" aria-hidden="true"></div>
    <div class="relative rounded-xl border border-border bg-card p-5 shadow-[0_20px_38px_-30px_rgba(34,42,32,.45)] sm:p-8">
      <div class="flex items-end justify-between gap-4 border-b-2 border-primary pb-5">
        <div>
          <p class="sheet-number text-xs uppercase tracking-widest text-muted-foreground">Rentalin / Operations</p>
          <h2 class="mt-2 text-2xl font-semibold tracking-tight sm:text-3xl">Rental dispatch</h2>
        </div>
        <span class="sheet-number text-xs text-muted-foreground">Sample workflow</span>
      </div>
      <ol class="divide-y divide-border">
        {steps.map((step) => (
          <li class="grid grid-cols-[2.5rem_1fr] items-center gap-x-4 gap-y-2 py-5 sm:grid-cols-[2.5rem_1fr_auto]">
            <span class="sheet-number text-sm text-accent">{step.number}</span>
            <span class="flex items-center gap-2.5 font-semibold"><step.Icon class="size-4 shrink-0 text-primary" strokeWidth={1.8} aria-hidden="true" />{step.label}</span>
            <span class="col-start-2 w-fit rounded-md bg-muted px-2.5 py-1 text-xs font-semibold text-primary sm:col-start-3">{step.state}</span>
          </li>
        ))}
      </ol>
      <div class="sheet-number flex justify-between gap-4 border-t border-border pt-5 text-xs text-muted-foreground"><span>Every step documented</span><span>Inquiry → return</span></div>
    </div>
  </div>
</section>

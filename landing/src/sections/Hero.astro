---
import { MessageCircle } from 'lucide-react';
import ClientAurora from '../components/ClientAurora.astro';
import ClientSplitText from '../components/ClientSplitText.astro';
import ClientBlurText from '../components/ClientBlurText.astro';
import { DEMO_WA_LINK } from '../lib/contact';

const trustSignals = [
  'For rental businesses with 1\u201350 vehicles',
  'Indonesia-first design',
  'Works offline, outdoors, one-handed'
];
---

<section class="relative min-h-dvh overflow-hidden">
  <!-- Layer 1: Aurora haze + readability gradient -->
  <div class="absolute inset-0 z-0">
    <ClientAurora colorStops={['#5227FF', '#e6a817', '#22c55e']} />
    <div class="absolute inset-0 bg-gradient-to-b from-background/70 via-transparent to-background" />
  </div>

  <!-- Layer 2: content -->
  <div class="relative z-10 flex min-h-dvh items-center justify-center px-4 py-24 sm:px-6">
    <div class="mx-auto max-w-4xl text-center">
      <div class="mb-8 inline-flex items-center rounded-full border border-primary/40 bg-background/40 px-4 py-1.5 font-mono text-xs uppercase tracking-widest text-primary">
        Operational tool — not a marketplace
      </div>

      <ClientSplitText
        text="The engine behind every rental."
        tag="h1"
        className="text-4xl font-bold tracking-tight text-foreground font-heading sm:text-6xl lg:text-7xl max-w-4xl"
      />

      <ClientBlurText
        text="Manage your fleet, track inspections, monitor rentals — all from one place. Built for rental businesses across Indonesia."
        className="mt-6 text-lg text-muted-foreground lg:text-xl max-w-2xl mx-auto"
      />

      <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a
          href={DEMO_WA_LINK}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex h-12 items-center gap-2 rounded-lg bg-primary px-8 font-semibold text-primary-foreground transition-opacity hover:opacity-90"
        >
          <MessageCircle class="size-5" />
          Book a Demo
        </a>
        <a
          href="/login"
          class="inline-flex h-12 items-center rounded-lg border border-border px-8 font-semibold text-foreground transition-colors hover:border-primary"
        >
          Staff Login
        </a>
      </div>

      <div class="mt-8 flex flex-wrap items-center justify-center gap-x-4 gap-y-2 text-xs text-muted-foreground">
        {trustSignals.map((label) => (
          <span class="inline-flex items-center gap-1.5">
            <span class="size-1.5 rounded-full bg-primary" />
            {label}
          </span>
        ))}
      </div>
    </div>
  </div>
</section>

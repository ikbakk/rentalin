---
import { Car, Camera, History } from 'lucide-react';
const features = [
  { title: 'Know what is available', detail: 'Keep vehicles and their status in one working list, ready when a new inquiry comes in.', marker: 'Fleet management', Icon: Car },
  { title: 'See the condition', detail: 'Capture inspection photos before and after a rental, linked to the vehicle and booking.', marker: 'Inspection checklists', Icon: Camera },
  { title: 'Follow every change', detail: 'A timestamped timeline shows what happened and who recorded it.', marker: 'Timeline audit trail', Icon: History },
];
---

<section id="features" class="py-20 lg:py-28">
  <div class="mx-auto grid max-w-7xl gap-12 px-5 sm:px-8 lg:grid-cols-[.7fr_1.3fr] lg:gap-20 lg:px-12">
    <div>
      <h2 class="max-w-md text-4xl font-semibold leading-[1.06] tracking-[-.045em] text-balance sm:text-5xl">The details stay together.</h2>
      <p class="mt-6 max-w-sm leading-relaxed text-muted-foreground">A busy rental day should still be easy to read. Fleet, condition and history share the same record.</p>
    </div>
    <div class="border-t-2 border-primary">
      {features.map((feature) => (
        <article class="grid gap-4 border-b border-border py-7 sm:grid-cols-[3rem_1fr_auto] sm:items-start sm:gap-6">
          <span class="flex size-10 items-center justify-center rounded-lg border border-border bg-card text-primary"><feature.Icon class="size-5" strokeWidth={1.7} aria-hidden="true" /></span>
          <div><h3 class="text-2xl font-semibold tracking-tight">{feature.title}</h3><p class="mt-2 max-w-md text-sm leading-relaxed text-muted-foreground">{feature.detail}</p></div>
          <span class="sheet-number w-fit rounded-md bg-muted px-3 py-1.5 text-xs text-primary">{feature.marker}</span>
        </article>
      ))}
    </div>
  </div>
</section>
